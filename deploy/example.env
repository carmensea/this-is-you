# Copy to .env beside compose.yaml. Holds no secrets, but keep it private anyway.
TIY_VERSION=local
# The machine's name on your tailnet, and the one address the app answers on. Lowercase, https, no path.
TIY_TAILNET_NAME=archive
TIY_PUBLIC_ORIGIN=https://archive.your-tailnet.ts.net
# Created by deploy/setup-host.sh.
TIY_DATA_DIR=/srv/this-is-you/data
TIY_TAILSCALE_DIR=/srv/this-is-you/tailscale
# The folder holding the backup drive's mount point. The drive itself mounts at backup-drive inside it. See docs/deployment.md.
TIY_BACKUP_PARENT=/mnt/this-is-you
# A file holding a Tailscale auth key, readable only by root. Never put the key itself in this file.
TIY_AUTHKEY_FILE=/srv/this-is-you/secrets/ts_authkey
